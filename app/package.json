{
  "name": "fedagent-studio",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8880",
    "diagrams:build": "python3 ../tools/algorithm-diagrams/build.py",
    "diagrams:check": "python3 ../tools/algorithm-diagrams/build.py --check",
    "prebuild": "npm run diagrams:check",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run lint && npm run check:structure && npm run typecheck && npm test && npm run build",
    "api:types": "cd ../server && uv run fedagent openapi > ../app/src/api/openapi.json && cd ../app && npx --yes openapi-typescript@7.13.0 src/api/openapi.json -o src/api/schema.d.ts",
    "check:structure": "node ../tools/check-frontend-structure.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "cmdk": "^1.1.1",
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
